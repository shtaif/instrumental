{
  "name": "main-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "license": "MIT",
  "engines": {
    "bun": "^1.1.34"
  },
  "scripts": {
    "dev": "concurrently -r -P \"pnpm dev:app\" \"pnpm dev:gql-codegen-watch\"",
    "dev:app": "bun --watch ./src/index.ts",
    "dev:gql-codegen-watch": "cd ../main-service-gql-codegen && pnpm start",
    "test": "NODE_COMPILE_CACHE=./_node_compile_cache vitest run --config ./spec/vitest.config.ts",
    "test:dev": "NODE_COMPILE_CACHE=./_node_compile_cache vitest --config ./spec/vitest.config.ts",
    "test:dev-with-gql-codegen": "concurrently -r -P \"cd ../main-service-gql-codegen && pnpm start\" \"pnpm test:dev {*}\"",
    "build": "rm -rf ./dist && tsc --outDir ./dist && copyfiles -u 1 ./src/**/*.graphql ./dist"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@graphql-tools/schema": "^10.0.23",
    "@graphql-tools/utils": "^10.8.6",
    "@ngrok/ngrok": "^0.5.2",
    "@reactivex/ix-esnext-esm": "^7.0.0",
    "axios": "^1.8.4",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "country-locale-map": "^1.9.9",
    "csv-parse": "^5.6.0",
    "dataloader": "^2.2.3",
    "eventsource": "^2.0.2",
    "express": "^4.21.2",
    "graphql": "16.9.0",
    "graphql-ws": "^5.16.2",
    "http-terminator": "^3.2.0",
    "iter-tools": "^7.5.3",
    "iterable-operators": "workspace:^",
    "iterified": "^1.2.5",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "shared-utils": "workspace:^",
    "supertokens-node": "^20.1.6",
    "uuid": "^9.0.1",
    "ws": "^8.18.1",
    "yahoo-finance2": "^2.13.3",
    "znv": "^0.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.0",
    "@parcel/watcher": "^2.5.1",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.17",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-standard": "^17.1.0",
    "prettier": "^3.5.3",
    "ts-toolbelt": "^9.6.0",
    "typescript": "^5.8.2",
    "utility-types": "^3.11.0",
    "vitest": "~3.0.9"
  }
}
